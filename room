<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ROOM</title>
  <style>
    body {margin: 0; overflow: hidden; touch-action:none; background:black;}
  </style>
</head>

<body>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>

const renderer = new THREE.WebGLRenderer({antialias: true});
renderer.setPixelRatio(window.devicePixelRatio);
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0xffffff);

const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(4, 4, 7);
camera.lookAt(0, 0, -2.5);

// FLOOR
const floorGeometry = new THREE.BoxGeometry(8, 0.1, 8);
const floorMaterial = new THREE.MeshBasicMaterial({color: 0xe5e5e2});
const floor = new THREE.Mesh(floorGeometry, floorMaterial);
floor.position.set(0, -2, -4);
scene.add(floor);

// BACK WALL
const backWallGeometry = new THREE.BoxGeometry(8, 4, 0.1);
const backWallMaterial = new THREE.MeshBasicMaterial({color: 0xf2f2f0});
const backWall = new THREE.Mesh(backWallGeometry, backWallMaterial);
backWall.position.set(0,0,-8);
scene.add(backWall);

// LEFT WALL
const leftWallGeometry = new THREE.BoxGeometry(0.1, 4, 8);
const leftWallMaterial = new THREE.MeshBasicMaterial({color: 0xf2f2f0});
const leftWall = new THREE.Mesh(leftWallGeometry,leftWallMaterial);
leftWall.position.set(-4, 0, -4);
scene.add(leftWall);

// RIGHT WALL
const rightWallGeometry = new THREE.BoxGeometry(0.1, 4, 8);
const rightWallMaterial = new THREE.MeshBasicMaterial({color: 0xf2f2f0});
const rightWall = new THREE.Mesh(rightWallGeometry, rightWallMaterial);
rightWall.position.set(4, 0, -4);
scene.add(rightWall);

// 선반과 책
const shelfMaterial = new THREE.MeshBasicMaterial({ color: 0xcfcfcb });
const bookMaterial = new THREE.MeshBasicMaterial({ color: 0xb8b8b5 });
const starBookMaterial = new THREE.MeshBasicMaterial({ color: 0xffffff });

// 기준값
const shelfX = 0.15;
const shelfZ = -7.15;
const bookZ = -7.05;

const shelfWidth = 4.9;
const shelfHeight = 0.12;
const shelfDepth = 0.25;

const bookWidth = 0.14;
const bookHeight = 0.65;
const bookDepth = 0.18;
const bookGap = 0.18;

const bookOffsetX = 0.11;
const bookOnShelf = 0.34;

// 선반 y좌표
const shelfY1 = 0.78;
const shelfY2 = -0.12;
const shelfY3 = -1.02;

// 책 y좌표 = 선반 y + 책 올림값
const bookY1 = shelfY1 + bookOnShelf;
const bookY2 = shelfY2 + bookOnShelf;
const bookY3 = shelfY3 + bookOnShelf;

// 선반 만들기
function createShelf(y) {
  const shelf = new THREE.Mesh(
    new THREE.BoxGeometry(shelfWidth, shelfHeight, shelfDepth), shelfMaterial);
  shelf.position.set(shelfX, y, shelfZ);
  scene.add(shelf);}

// 책 만들기
function createMonthBooks(startX, y, count) {
  for (let i = 0; i < count; i++) {
    const book = new THREE.Mesh(
      new THREE.BoxGeometry(bookWidth, bookHeight, bookDepth),
      i === 0 ? starBookMaterial : bookMaterial);
    book.position.set(startX + i * bookGap, y, bookZ);
    scene.add(book);}}

// 선반 3개
createShelf(shelfY1);
createShelf(shelfY2);
createShelf(shelfY3);

// 1행
createMonthBooks(-2.0 + bookOffsetX, bookY1, 4);
createMonthBooks(-0.75 + bookOffsetX, bookY1, 4);
createMonthBooks(0.5 + bookOffsetX, bookY1, 4);
createMonthBooks(1.75 + bookOffsetX, bookY1, 4);

// 2행
createMonthBooks(-2.0 + bookOffsetX, bookY2, 4);
createMonthBooks(-0.75 + bookOffsetX, bookY2, 4);
createMonthBooks(0.5 + bookOffsetX, bookY2, 4);
createMonthBooks(1.75 + bookOffsetX, bookY2, 4);

// 3행
createMonthBooks(-2.0 + bookOffsetX, bookY3, 4);
createMonthBooks(-0.75 + bookOffsetX, bookY3, 4);
createMonthBooks(0.5 + bookOffsetX, bookY3, 4);
createMonthBooks(1.75 + bookOffsetX, bookY3, 4);

renderer.render(scene, camera);

</script>

</body>

</html>
